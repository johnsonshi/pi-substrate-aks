{
  "name": "pi-substrate-aks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "preflight": "./scripts/preflight.sh",
    "smoke:copilot": "tsx scripts/smoke-copilot.ts",
    "smoke:pi-copilot": "tsx scripts/smoke-pi-copilot.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
