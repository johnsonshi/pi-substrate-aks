{
  "name": "pi-substrate-aks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "preflight": "./scripts/preflight.sh",
    "security:local": "node --import tsx --test tests/unit/copilot-broker.test.ts tests/integration/model-relay.test.ts tests/integration/pi-actor.test.ts tests/security/prompt-injection.test.ts",
    "security:prompt-injection": "node --import tsx --test tests/security/prompt-injection.test.ts",
    "security:remote": "tsx scripts/verify-remote-security.ts",
    "smoke:copilot": "tsx scripts/smoke-copilot.ts",
    "smoke:multi-actor": "tsx scripts/smoke-multi-actor.ts",
    "smoke:pi-copilot": "tsx scripts/smoke-pi-copilot.ts",
    "smoke:remote-actor": "tsx scripts/smoke-remote-actor.ts",
    "smoke:transport:local": "node --import tsx --test tests/integration/source-transport.test.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "8.18.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
